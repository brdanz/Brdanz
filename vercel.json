{
  "version": 2,
  "rewrites": [
    { "source": "/api/smm", "destination": "/api/smm.js" },
    { "source": "/api/qris", "destination": "/api/qris.js" },
    { "source": "/api/otp", "destination": "/api/otp.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}